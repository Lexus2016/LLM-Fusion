#!/usr/bin/env bash
# fusion-claude — launch Claude Code wired to the llm-fusion Fusion Proxy.
#
# Usage:
#   fusion-claude <model> [claude args...]
#   fusion-claude fusion-agents                 # interactive TUI with smart routing
#   fusion-claude fusion-coder                  # interactive TUI for coding
#   fusion-claude fusion-researcher run "Summarize X"  # headless one-shot
#
# What it does:
#   1. starts the proxy (npm start) if it is not already answering on /health;
#   2. exports the Anthropic env vars Claude Code needs;
#   3. launches claude with the remaining arguments.
#
# Env:
#   FUSION_PROXY_URL           override proxy URL (default: 127.0.0.1 on the port in fusion.yaml)
#   FUSION_CONFIG              config file to read the port from (default ./fusion.yaml)
#   FUSION_PROXY_TOKEN         if your proxy requires client auth, used as ANTHROPIC_AUTH_TOKEN
#   ANTHROPIC_SMALL_FAST_MODEL override the fast model Claude uses for light tasks (default fast-background)
set -euo pipefail

# The first positional arg selects the model, but ONLY when it is not a flag.
# Otherwise `fusion-claude --mcp-config <file>` would swallow `--mcp-config` as
# the model name and drop the flag; a leading `-...` means "no model given —
# use the default and pass every arg straight through to claude".
MODEL="fusion-agents"
if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
  MODEL="$1"
  shift
fi

# Resolve the script's real location even when invoked through a symlink
# (e.g. ~/.local/bin/fusion-claude -> .../llm-fusion/bin/fusion-claude) —
# BASH_SOURCE alone points at the symlink, not the target, and dirname on
# that yields the wrong REPO.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
# The proxy URL comes from the CONFIG, not a hardcoded port: fusion.yaml has
# served 8081 since 2026-07 while this script still defaulted to 8080, so the
# health probe missed a running proxy and started a second one. FUSION_PROXY_URL
# still wins; FUSION_CONFIG selects the config (e.g. ./fusion.tuned.yaml).
FUSION_CONFIG_PATH="${FUSION_CONFIG:-$REPO/fusion.yaml}"
config_port() {
  python3 - "$1" <<'PYEOF' 2>/dev/null || echo 8080
import sys, re
try:
    text = open(sys.argv[1]).read()
except OSError:
    print(8080); raise SystemExit
# Deliberately a regex, not a YAML parse: this script must not depend on a
# python yaml module being installed. `port:` under `server:` at two-space indent.
m = re.search(r"^server:\s*$(.*?)(?=^\S)", text, re.M | re.S)
block = m.group(1) if m else text
m = re.search(r"^\s{2}port:\s*(\d+)", block, re.M)
print(m.group(1) if m else 8080)
PYEOF
}
PROXY_PORT="$(config_port "$FUSION_CONFIG_PATH")"
PROXY_URL="${FUSION_PROXY_URL:-http://127.0.0.1:$PROXY_PORT}"

# 1. ensure the proxy is up ---------------------------------------------------
if ! curl -fsS "$PROXY_URL/health" >/dev/null 2>&1; then
  echo "[fusion-claude] proxy not up — starting it from $REPO ..." >&2
  ( cd "$REPO" && nohup npm start >"${TMPDIR:-/tmp}/llm-fusion-proxy.log" 2>&1 & )
  for _ in $(seq 1 60); do
    curl -fsS "$PROXY_URL/health" >/dev/null 2>&1 && break
    sleep 0.5
  done
  if ! curl -fsS "$PROXY_URL/health" >/dev/null 2>&1; then
    echo "[fusion-claude] proxy failed to start — see ${TMPDIR:-/tmp}/llm-fusion-proxy.log" >&2
    exit 1
  fi
  echo "[fusion-claude] proxy is up at $PROXY_URL" >&2
fi

# 2. wire Claude Code to the proxy -------------------------------------------
export ANTHROPIC_BASE_URL="$PROXY_URL"
export ANTHROPIC_MODEL="$MODEL"
# The small/fast model must NOT share a rate-limit bucket with anything the
# main loop depends on: Claude Code fires background bursts of 80-130 small
# calls/min, and on 2026-07-06 those bursts 429-starved kimi-k2.7-code — the
# fusion-coder synth at the time — killing large-file generation mid-loop.
# `fast-deepseek` was the old default and is NO LONGER SAFE: its target
# deepseek-v4-flash:0731-cloud holds a panel seat in both fusion models.
# `fast-background` exists precisely for this role and holds no pipeline role;
# the proxy warns at startup if the model you pick overlaps a panel.
export ANTHROPIC_SMALL_FAST_MODEL="${ANTHROPIC_SMALL_FAST_MODEL:-fast-background}"
export ANTHROPIC_AUTH_TOKEN="${FUSION_PROXY_TOKEN:-local-no-auth}"

# A user-level ~/.claude/settings.json `env` block (e.g. a personal
# secrets-redaction proxy pinned via ANTHROPIC_BASE_URL) wins over plain
# exported env vars, so exporting alone does not reliably point Claude Code
# at the Fusion Proxy. `--settings <file>` loads an extra settings layer for
# just this invocation that overrides that env block. The JSON is written to
# a 0600 temp file (not passed inline) and removed on exit — passing it as a
# CLI arg instead would leak ANTHROPIC_AUTH_TOKEN to any local user via
# `ps`/procfs, unlike an env var of the same process.
FUSION_CLAUDE_SETTINGS="$(mktemp -t fusion-claude-settings.XXXXXX)"
chmod 600 "$FUSION_CLAUDE_SETTINGS"
trap 'rm -f "$FUSION_CLAUDE_SETTINGS"' EXIT INT TERM
python3 -c '
import json, sys
with open(sys.argv[5], "w") as f:
    json.dump({"env": {
        "ANTHROPIC_BASE_URL": sys.argv[1],
        "ANTHROPIC_MODEL": sys.argv[2],
        "ANTHROPIC_SMALL_FAST_MODEL": sys.argv[3],
        "ANTHROPIC_AUTH_TOKEN": sys.argv[4],
    }}, f)
' "$ANTHROPIC_BASE_URL" "$ANTHROPIC_MODEL" "$ANTHROPIC_SMALL_FAST_MODEL" "$ANTHROPIC_AUTH_TOKEN" "$FUSION_CLAUDE_SETTINGS"

# 3. launch Claude Code (not exec'd, so the EXIT trap still runs afterwards
# to delete the temp settings file) -------------------------------------------
echo "[fusion-claude] launching: claude $* (model=$ANTHROPIC_MODEL, fast=$ANTHROPIC_SMALL_FAST_MODEL)" >&2
claude --settings "$FUSION_CLAUDE_SETTINGS" "$@"
